{
  "name": "gesture-vision",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "scripts": {
    "copy:wasm": "mkdir -p packages/frontend/public/wasm && { { [ -f packages/frontend/public/wasm/vision_wasm_internal.wasm ] && [ $(wc -c < packages/frontend/public/wasm/vision_wasm_internal.wasm) -ge 4000000 ]; } || cp -r node_modules/@mediapipe/tasks-vision/wasm/* packages/frontend/public/wasm/; }",
    "copy:models": "mkdir -p packages/frontend/public/models && { { [ -f packages/frontend/public/models/gesture_recognizer.task ] && [ $(wc -c < packages/frontend/public/models/gesture_recognizer.task) -ge 5000000 ] && [ -f packages/frontend/public/models/pose_landmarker_lite.task ] && [ $(wc -c < packages/frontend/public/models/pose_landmarker_lite.task) -ge 3000000 ]; } || { curl -L -o packages/frontend/public/models/gesture_recognizer.task https://storage.googleapis.com/mediapipe-models/gesture_recognizer/gesture_recognizer/float16/1/gesture_recognizer.task && curl -L -o packages/frontend/public/models/pose_landmarker_lite.task https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_lite/float16/1/pose_landmarker_lite.task; }; }",
    "build:backend": "echo 'Skipping backend pre-build...'",
    "dev": "npm run copy:wasm && npm run copy:models && npm run build:backend && NODE_ENV=development tsx --experimental-specifier-resolution=node --tsconfig tsconfig.json packages/backend/src/server.ts",
    "build:app": "npm run copy:wasm && npm run copy:models && npm run build:backend && cd packages/frontend && vite build",
    "build": "npm run build:app",
    "start": "tsx --tsconfig tsconfig.json packages/backend/src/server.ts",
    "start:prod": "NODE_ENV=production tsx --experimental-specifier-resolution=node --tsconfig tsconfig.json packages/backend/src/server.ts",
    "preview": "cd packages/frontend && vite preview",
    "lint:js": "eslint . --ext .js,.mjs,.cjs,.ts,.tsx",
    "lint:html": "htmlhint packages/frontend/src/partials/**/*.html packages/frontend/index.html",
    "type-check": "tsc --noEmit",
    "lint-and-check": "npm-run-all --parallel lint:js lint:html type-check"
  },
  "imports": {
    "#backend/*": "./packages/backend/src/*",
    "#shared/*": "./packages/shared/*",
    "#plugins/*": "./extensions/plugins/*",
    "#frontend/*": "./packages/frontend/src/*"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.21",
    "autoprefixer": "^10.4.21",
    "cors": "^2.8.5",
    "cssnano": "^7.0.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "immer": "^10.1.1",
    "mqtt": "^5.13.1",
    "node-fetch": "^3.3.2",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "serialize-javascript": "^7.0.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "ws": "^8.18.2",
    "zod": "^4.1.7",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.29.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.7",
    "globals": "^16.2.0",
    "htmlhint": "^1.5.1",
    "npm-run-all": "^4.1.5",
    "rollup-plugin-visualizer": "^6.0.3",
    "tailwindcss": "^3.4.4",
    "typescript-eslint": "^8.34.0",
    "vite": "^7.0.4",
    "vite-plugin-pwa": "^1.2.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.3"
  }
}
