{
  "name": "GestureVision",
  "short_name": "GestureV",
  "description": "AI Gesture Recognition WebApp",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "lang": "en",
  "scope": "/",
  "orientation": "any",
  "shortcuts": [
    {
      "name": "Dashboard",
      "short_name": "Dashboard",
      "description": "Launch the interactive Dashboard",
      "url": "/#dashboard",
      "icons": [{ "src": "/icons/icon-192.webp", "sizes": "192x192" }]
    },
    {
      "name": "Settings",
      "short_name": "Settings",
      "description": "Go to GestureVision Settings",
      "url": "/#settings",
      "icons": [{ "src": "/icons/icon-192.webp", "sizes": "192x192" }]
    }
  ],
  "screenshots": [
    {
      "src": "/images/gesturevision_dark.webp",
      "sizes": "1920x1055",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Main interface on desktop - Dark Mode"
    },
    {
      "src": "/images/gesturevision_light.webp",
      "sizes": "1920x1055",
      "type": "image/webp",
      "form_factor": "wide",
      "label": "Main interface on desktop - Light Mode"
    },
    {
      "src": "/images/gesturevision_mobile.webp",
      "sizes": "480x985",
      "type": "image/webp",
      "form_factor": "narrow",
      "label": "Gesture recognition on mobile"
    }
  ],
  "icons": [
    {
      "src": "/icons/icon-192.webp",
      "type": "image/webp",
      "sizes": "192x192",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192.webp",
      "type": "image/webp",
      "sizes": "192x192",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.webp",
      "type": "image/webp",
      "sizes": "512x512",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-maskable-512.webp",
      "type": "image/webp",
      "sizes": "512x512",
      "purpose": "maskable"
    }
  ]
}