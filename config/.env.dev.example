# FILE: config/.env.dev.example - Template for development environment
# Copy this file to config/.env.dev and fill in your values.

# Docker image name and tag
DEV_IMAGE_NAME=gesturevision-dev:latest

# Ports for development
DEV_VITE_PORT=8001
DEV_BACKEND_API_PORT_INTERNAL=9001

# MediaMTX Ports
MTX_DEV_WEBRTC_PORT=8889
MTX_DEV_RTSP_PORT=8554
MTX_DEV_ICE_UDP_PORT=8189
MTX_APIADDRESS_INTERNAL=9997

# Docker Network
NPM_NETWORK_NAME=docker_network
DOCKER_IPV4_ADDRESS=192.168.20.71

# MediaMTX Config
MTX_LOGLEVEL=debug
MTX_API=yes
MTX_ICE_HOST=127.0.0.1

# Home Assistant Integration (optional defaults)
VITE_DEV_HA_DEFAULT_URL=
