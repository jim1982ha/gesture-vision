# FILE: config/.env.prod.example - Template for production environment
# Copy this file to config/.env.prod and fill in your values.

# Production image name and tag
PROD_IMAGE_NAME=gesturevision-prod:latest

# App URL (external access)
APP_EXTERNAL_URL=https://gesture.mydomain.com

# Docker Network name used by NPM
NPM_NETWORK_NAME=docker_network

# Docker IPv4 Address (when using Macvlan network)
DOCKER_IPV4_ADDRESS=192.168.20.64

# Host IP/Domain for ICE communication (important for WebRTC streaming)
MTX_ICE_HOST=127.0.0.1

# MediaMTX Ports & Config (Optional host mappings, and required internal listeners)
MTX_PROD_WEBRTC_PORT=8888
MTX_PROD_WEBRTC_PORT_INTERNAL=8888

MTX_PROD_ICE_UDP_PORT=8189
MTX_PROD_ICE_UDP_PORT_INTERNAL=8189

MTX_PROD_RTMP_PORT=1935
MTX_PROD_RTMP_PORT_INTERNAL=1935

MTX_PROD_RTSP_PORT=8554
MTX_PROD_RTSP_PORT_INTERNAL=8554

MTX_PROD_LOGLEVEL=info
MTX_PROD_HLS_ADDRESS=

# MediaMTX API configuration
MTX_API=yes
MTX_APIADDRESS_INTERNAL=0.0.0.0:9997

# Backend API port
BACKEND_API_PORT_INTERNAL=9001

# Home Assistant Integration defaults (build time settings)
VITE_PROD_HA_DEFAULT_URL=
VITE_PROD_HA_DEFAULT_TOKEN=
